/.gitattributes text eol=lf

# Files to store in git-lfs

# Images
*.png	filter=lfs	diff=lfs	merge=lfs
*.jpg	filter=lfs	diff=lfs	merge=lfs
*.jpeg	filter=lfs	diff=lfs	merge=lfs
*.webp	filter=lfs	diff=lfs	merge=lfs
*.gif	filter=lfs	diff=lfs	merge=lfs
*.bmp	filter=lfs	diff=lfs	merge=lfs
*.tiff	filter=lfs	diff=lfs	merge=lfs
*.tif	filter=lfs	diff=lfs	merge=lfs
*.ico	filter=lfs	diff=lfs	merge=lfs
*.heic	filter=lfs	diff=lfs	merge=lfs
*.heif	filter=lfs	diff=lfs	merge=lfs
*.raw	filter=lfs	diff=lfs	merge=lfs
*.svg	filter=lfs	diff=lfs	merge=lfs

# Archives
*.7z	filter=lfs	diff=lfs	merge=lfs
*.br	filter=lfs	diff=lfs	merge=lfs
*.gz	filter=lfs	diff=lfs	merge=lfs
*.tar	filter=lfs	diff=lfs	merge=lfs
*.zip	filter=lfs	diff=lfs	merge=lfs
*.rar	filter=lfs	diff=lfs	merge=lfs

# Video
*.mkv	filter=lfs	diff=lfs	merge=lfs
*.avi	filter=lfs	diff=lfs	merge=lfs
*.mov	filter=lfs	diff=lfs	merge=lfs
*.mp4	filter=lfs	diff=lfs	merge=lfs
*.flv	filter=lfs	diff=lfs	merge=lfs
*.mpg	filter=lfs	diff=lfs	merge=lfs
*.mpeg	filter=lfs	diff=lfs	merge=lfs
*.vob	filter=lfs	diff=lfs	merge=lfs
*.amv	filter=lfs	diff=lfs	merge=lfs
*.3gp	filter=lfs	diff=lfs	merge=lfs

# Disk images
*.iso	filter=lfs	diff=lfs	merge=lfs
*.elf	filter=lfs	diff=lfs	merge=lfs

# Exe
*.exe	filter=lfs	diff=lfs	merge=lfs
*.msi	filter=lfs	diff=lfs	merge=lfs
*.dll	filter=lfs	diff=lfs	merge=lfs

# Shell scripts must keep Unix line endings.
*.sh	text eol=lf

# GNU Stow reads this file as line-based regular expressions.
/.stow-local-ignore text eol=lf
