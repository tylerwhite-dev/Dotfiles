{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,

  "model": "opencode/big-pickle",

  "compaction": { "auto": true },

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1",
      },
      "models": {
        "omnicoder-9b": {
          "name": "Omnicoder 9b",
          "limit": {
            "context": 24000,
            "output": 6000,
          },
        },
        "qwen/qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35b moe",
          "limit": {
            "context": 32000,
            "output": 8000,
          },
        },
      },
    },
  },

  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat*": "allow",
      "grep*": "allow",
      "find*": "allow",
      "pwd*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "echo*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git *": "allow",
      "git commit*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "rm*": "ask",
      "mv*": "ask",
      "sudo*": "ask",
    },
    "edit": { "*": "allow" },
    "read": { "*": "allow" },
    "glob": { "*": "allow" },
    "grep": { "*": "allow" },
  },
}
