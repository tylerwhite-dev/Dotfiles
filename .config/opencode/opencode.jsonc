{
  "$schema": "https://opencode.ai/config.json",

  "autoupdate": false,

  "model": "opencode/big-pickle",

  "compaction": { "auto": true },

  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio",
      "options": {
        "baseURL": "http://localhost:1234/v1",
      },
      "models": {
        "omnicoder-9b": {
          "name": "Omnicoder 9b",
          "limit": {
            "context": 24000,
            "output": 6000,
          },
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35b MoE",
          "limit": {
            "context": 48000,
            "output": 12000,
          },
        },
      },
    },
  },

  "permission": {
    "bash": {
      "*": "allow",
      "rm*": "ask",
      "rm -rf*": "ask",
      "chmod*": "ask",
      "chown*": "ask",
      "sudo*": "ask",
      "kill*": "ask",
      "mkfs*": "ask",
      "dd*": "ask",
      "wget*": "ask",
      "curl*": "ask",
      "ssh*": "ask",
      "scp*": "ask",
      "rsync*": "ask",
      "docker rm -f*": "ask",
      "docker rmi*": "ask",
      "docker volume rm*": "ask",
      "docker volume prune*": "ask",
      "docker network rm*": "ask",
      "docker system prune*": "ask",
      "docker run -v /:*": "ask",
      "docker run --privileged*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git revert*": "ask",
      "pip install*": "ask",
      "npm install -g*": "ask",
    },
    "edit": { "*": "allow" },
    "read": { "*": "allow" },
    "glob": { "*": "allow" },
    "grep": { "*": "allow" },
  },
}
