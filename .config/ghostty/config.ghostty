# theme
theme = XcodeCustom
# Xcode Dark hc
# Starlight
# One Dark Two
# Monokai Pro Spectrum

# behaviour

macos-option-as-alt = true
confirm-close-surface = false

# style

cursor-style = underline

window-padding-x = 4
window-padding-y = 4
window-width = 132
window-height = 40

# font
font-family = JetBrainsMono Nerd Font
font-feature = -calt

# keybinds

keybind = alt+left=unbind
keybind = alt+right=unbind
